{
  "$schema": "https://raw.githubusercontent.com/nicedouble/tauri-config-schema/refs/heads/main/tauri.conf.json",
  "productName": "MultiTools",
  "version": "0.1.0",
  "identifier": "com.multitools.app",
  "build": {
    "beforeDevCommand": "cd .. && npm run front:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd .. && npm run front:build",
    "frontendDist": "../../front/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MultiTools — Homebrew Toolbox",
        "width": 970,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["templates/*"]
  }
}
